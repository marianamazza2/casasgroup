{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "casasgroup.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/servicios/administracion-de-fincas",
      "destination": "/servicios/administracion-de-comunidades",
      "permanent": true
    }
  ],
  "cleanUrls": true
}
